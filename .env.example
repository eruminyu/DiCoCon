# ==========================================================
# 디스코드 큰 이모지 & 커스텀 콘 통합 봇 설정 예시 (.env.example)
# 사용 시 이 파일의 이름을 .env 로 복사한 뒤 토큰을 입력하세요.
# ==========================================================

DISCORD_TOKEN=여기에_디스코드_봇_토큰을_넣어주세요
AUTO_ENLARGE_EMOJI=true
EMOJI_SIZE=128
CON_MAX_SIZE=140
CON_PREFIX=;
ALLOWED_USER_IDS=
