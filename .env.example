# ==========================================================
# 디코콘 (DiCoCon) 설정 예시 (.env.example)
# ==========================================================

DISCORD_TOKEN=여기에_디스코드_봇_토큰을_넣어주세요
AUTO_ENLARGE_EMOJI=true
EMOJI_SIZE=128

# 로컬 전용 커스텀 콘 저장 기능 활성화 여부
# - 온라인 초대링크 배포 시: false (디스코드 자체 이모지 확대만 동작)
# - 내 PC 로컬 직접 실행 시: true (cons/ 폴더 및 우클릭 콘 저장 활성화, 실행.bat 사용 시 자동 true)
LOCAL_MODE=false
CON_MAX_SIZE=140
CON_PREFIX=;
ALLOWED_USER_IDS=
